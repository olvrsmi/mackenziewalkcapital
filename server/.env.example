# Required. Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=

# Game seconds per real second. 1 = a game day per real day (the intended
# cadence), 3 = three game days per real day, 1440 = a game day per real
# minute (testing).
MW_TIME_SCALE=1

# Seconds in a game day, and how long a fully spent qubit takes to recharge
# in game seconds. Defaults: a 24h day, an 8h recharge.
# MW_GAME_DAY=86400
# MW_RECHARGE_GAME_SECONDS=28800

# Milliseconds between readouts once a stake is placed.
# MW_STEP_MS=15000

# Interpreter for the model. Defaults to model/.venv, then python3 on PATH.
# MW_PYTHON=/path/to/python3

# Where saved games live.
# MW_STATE_DIR=./state

# Optional allowlist of Telegram user ids while the prototype is private.
# MW_ALLOW=123456789,987654321
