# Copy to .env and fill in. .env is gitignored; never commit a token.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Bots
# ---------------------------------------------------------------------------
# Telegram allows exactly ONE long poll per token, and a second one evicts the
# first - so a server and a laptop cannot share a bot. Make two with @BotFather.

# The deployed bot. Used by `npm start`.
TELEGRAM_BOT_TOKEN=

# The development bot. Used by `npm run dev` and by anything with MW_LOCAL=1.
TELEGRAM_BOT_TOKEN_LOCAL=

# ---------------------------------------------------------------------------
# Time
# ---------------------------------------------------------------------------
# MW_TIME_SCALE is game seconds per real second, and everything else follows
# from it - including how often the news goes out, which is now expressed in
# game time and so needs no adjusting when you retune the scale:
#
#   scale   game day   readout / post   a round   recharge
#       1     24 h          1 h            7 h       8 h     the intended cadence
#       6      4 h         10 min         70 min    80 min
#      12      2 h          5 min         35 min    40 min
#      24      1 h        2.5 min         18 min    20 min   good for playtesting
#      60     24 min        1 min          7 min     8 min
#    1440      1 min        2.5 s         17 s      20 s     fast testing
#
MW_TIME_SCALE=60

# All in GAME seconds, so all of them follow MW_TIME_SCALE. A readout every
# game hour means t1 to t2 is one game hour; posting matches it by default, so
# each post carries exactly one reading.
# MW_GAME_DAY=86400
# MW_READOUT_GAME_SECONDS=3600
# MW_POST_GAME_SECONDS=3600
# MW_RECHARGE_GAME_SECONDS=28800

# Pins posting to a REAL interval instead, ignoring the scale. An escape hatch:
# setting it shorter than a readout means repeating readings players already
# have, and longer means batching several into one message.
# MW_POST_MS=

# ---------------------------------------------------------------------------
# Economy
# ---------------------------------------------------------------------------
# MW_START_BUDGET=1000
# MW_BUDGET_FLOOR=500
# MW_WEEK_BONUS=100
# MW_UPGRADE_COST=10

# ---------------------------------------------------------------------------
# Machinery
# ---------------------------------------------------------------------------
# Interpreter for the model. Defaults to model/.venv, then python3 on PATH.
# The QDrive engine needs Python 3.12 or newer.
# MW_PYTHON=/path/to/python3

# qdrive-api's src/, holding the engine model/engine.py drives. Private, so it
# is cloned rather than vendored - see deploy/README.md. Defaults to
# model/vendor/qdrive-api/src.
# MW_QDRIVE_API_SRC=/path/to/qdrive-api/src

# How many times a world is stepped before the round ends. A specification has
# no natural end, so this is the whole answer to "how long is a round". One step
# produces one readout, so 10 gives t0..t9.
MW_STEPS=10

# How long a model call may take before it is killed.
# MW_MODEL_TIMEOUT=120000

# Where saved games live.
# MW_STATE_DIR=./state

# One JSON object per line, for `npm run stats`. Rotated at MW_LOG_MAX bytes.
# Contains chat ids, same as the state directory - treat it the same way.
# MW_LOG_FILE=./events.jsonl
# MW_LOG_MAX=16777216

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------
# Allowlist of Telegram user ids. If set, only these may play. Get an id by
# forwarding a message to @userinfobot.
# MW_ALLOW=123456789,987654321
